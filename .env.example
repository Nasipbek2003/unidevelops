# Шаблон переменных окружения. Скопируйте в .env и подставьте строки из Neon
# (Neon Console → Connect). Сам .env не коммитится.

# Pooled-подключение (хост с -pooler) для приложения (рантайм, src/lib/db.ts)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Прямое подключение (тот же хост без -pooler) для Prisma CLI и миграций (prisma7.config.ts)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Адрес сайта и аналитика (необязательно; без них соответствующие функции отключены) ---

# Публичный адрес сайта без слеша в конце: canonical, Open Graph, sitemap, robots, JSON-LD.
# Если не задан, берётся https://$VERCEL_PROJECT_PRODUCTION_URL (на Vercel), иначе http://localhost:3000.
# NEXT_PUBLIC_SITE_URL="https://example.com"

# Номер счётчика Яндекс Метрики (только цифры). Вебвизор выключен: он записывает поля формы.
# NEXT_PUBLIC_YM_ID="12345678"

# ID потока Google Analytics 4 (вид G-XXXXXXXXXX).
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
