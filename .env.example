# Шаблон переменных окружения. Скопируйте в .env и подставьте строки из Neon
# (Neon Console → Connect). Сам .env не коммитится.

# Pooled-подключение (хост с -pooler) для приложения (рантайм, src/lib/db.ts)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Прямое подключение (тот же хост без -pooler) для Prisma CLI и миграций (prisma7.config.ts)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
