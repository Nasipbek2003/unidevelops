// Схема БД лендинга UNIDEVELOPS (Neon PostgreSQL).
// Строки подключения задаются в prisma7.config.ts (CLI) и src/lib/db.ts (приложение).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Тип работы. Совпадает со списком workTypes (поле «Тип работы» формы) в src/content/index.ts,
// порядок тот же. При изменении списка в форме обновите enum и создайте миграцию.
enum WorkType {
  SRS // СРС
  ESSAY // Реферат / эссе
  PRESENTATION // Презентация
  COURSEWORK // Курсовая
  THESIS // Дипломная (ВКР)
  MASTERS_THESIS // Магистерская диссертация
  ARTICLE // Научная статья
  PRACTICE_REPORT // Отчёт по практике
  DEV_PROJECT // Проект с разработкой
  OTHER // Другое

  @@map("work_type")
}

// Статус обработки заявки.
enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
  REJECTED

  @@map("lead_status")
}

// Заявка с формы на сайте.
model Lead {
  id        String     @id @default(cuid())
  name      String
  // Телефон или Telegram
  contact   String
  workType  WorkType   @map("work_type")
  // Свободный текст, например «до 20 декабря»
  deadline  String?    @db.VarChar(100)
  comment   String?    @db.Text
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("leads")
}
